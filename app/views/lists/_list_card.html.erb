<div id="list_<%= list.id %>" class="card shadow-sm border-0 mb-3 rounded-3 animate__animated animate__fadeInUp">
  <div class="card-body d-flex align-items-center justify-content-between p-3">

    <!-- Left Side: Interactive Checkbox Form & Text Details -->
    <div class="d-flex align-items-center gap-3">
      
      <!-- Checkbox Form -->
      <form action="<%= toggle_list_path(list) %>" method="post" class="d-flex align-items-center m-0 p-0">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input class="form-check-input border-secondary shadow-sm m-0" 
               type="checkbox" 
               <%= 'checked' if list.completed? %> 
               style="cursor: pointer;"
               onchange="this.form.requestSubmit()"> 
      </form>

      <span class="fs-5 <%= 'text-decoration-line-through text-muted' if list.completed? %>">
        <%= list.description %>
      </span>

      <!-- Priority Badges -->
      <% unless list.completed? %>
        <% badge_color = case list.priority
                         when 'High' then 'bg-danger text-white'
                         when 'Medium' then 'bg-warning text-dark'
                         else 'bg-info text-dark'
                         end %>
        <span class="badge <%= badge_color %> rounded-pill px-2 py-1 fs-7 ms-2">
          <%= list.priority %>
        </span>
      <% end %>
    </div>

    <!-- Right Side: Clean Action Tools -->
    <div class="d-flex align-items-center gap-3">
      <!-- Edit Link Button -->
      <%= link_to 'Edit', edit_list_path(list), class: "btn btn-sm btn-outline-secondary px-3 rounded-pill fw-semibold" %>
      
      <!-- Bulletproof Delete Form -->
      <form action="<%= list_path(list) %>" method="post" class="m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this task?');">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit" class="btn-close bg-light p-2 rounded-circle shadow-sm border fs-7" style="width: 1.25rem; height: 1.25rem; display: block;"></button>
      </form>
    </div>

  </div>
</div>
